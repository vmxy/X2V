{
    "infer_steps": 4,
    "target_fps": 16,
    "video_duration": 360,
    "audio_sr": 16000,
    "target_height": 480,
    "target_width": 832,
    "target_video_length": 81,
    "resize_mode": "adaptive",
    "bucket_shape": {
        "0.667": [
            [
                480,
                832
            ],
            [
                544,
                960
            ]
        ],
        "1.500": [
            [
                832,
                480
            ],
            [
                960,
                544
            ]
        ],
        "1.000": [
            [
                480,
                480
            ],
            [
                576,
                576
            ],
            [
                704,
                704
            ]
        ]
    },
    "self_attn_1_type": "flash_attn2",
    "cross_attn_1_type": "flash_attn2",
    "cross_attn_2_type": "flash_attn2",
    "sample_guide_scale": 1.0,
    "sample_shift": 5,
    "enable_cfg": false,
    "cpu_offload": true,
    "t5_cpu_offload": true,
    "vae_cpu_offload": true,
    "audio_encoder_cpu_offload": true,
    "audio_adapter_cpu_offload": true,
    "use_31_block": true,
    "offload_granularity": "block",
    "use_image_encoder": false,
    
    "dit_quantized": true,
    "dit_quant_scheme": "fp8-sgl",
    "dit_quantized_ckpt":"/data/ai-models/lightx2v/wan2.2/wan2.2_s2v_14b_scaled_fp8.safetensors",

    "adapter_quantized": true,
    "adapter_quant_scheme": "fp8-sgl",
    "adapter_model_path":"/data/ai-models/SekoTek-V2.5/audio_adapter_model_fp8.safetensors",

    "t5_quantized": true,
    "t5_quant_scheme": "fp8-sgl",
    "t5_quantized_ckpt":"/data/ai-models/c/encoders/models_t5_umt5-xxl-enc-fp8.safetensors",
    
    "clip_quantized": true,
    "clip_quant_scheme": "fp8-sgl",
    "clip_quantized_ckpt": "/data/ai-models/c/encoders/models_clip_open-clip-xlm-roberta-large-vit-huge-14-fp8.safetensors",
    
    "audio_encoder_path": "/data/ai-models/c/TencentGameMate-chinese-hubert-large",

    "parallel": {
        "seq_p_size": 1,
        "seq_p_attn_type": "ulysses",
        "cfg_p_size": 2
    },
    "_use_lightvae": false,
    "vae_path": "/data/ai-models/c/vae/Wan2.2_VAE.safetensors",
    "use_tae": true,
    "tae_path": "/data/ai-models/c/vae/lighttaew2_2.safetensors"
}
